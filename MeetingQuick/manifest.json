{
  "manifest_version": 3,
  "name": "MeetingQuick",
  "version": "1.0.0",
  "description": "Manage your calendar meetings efficiently",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}

